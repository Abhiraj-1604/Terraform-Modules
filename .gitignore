# Terraform state files — never commit these
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Backend config — contains storage account details, keep local only
backend.hcl

# Crash log files
crash.log
crash.*.log

# Terraform variable files that may contain secrets
*.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
